{
  "name": "vault3r",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "VAULT — an encrypted, per-origin data vault built into the browser, with a crypto-wallet-style permission protocol. Monorepo.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run test",
    "e2e": "vitest run tests/e2e",
    "relay": "tsx servers/relay/src/bin.ts",
    "demo:signer": "tsx examples/demo-dapp/server.ts",
    "bundle:web": "node examples/demo-dapp/web/build.mjs",
    "demo": "pnpm run bundle:web && tsx examples/demo-dapp/demo-server.ts",
    "glue:smoke": "tsx examples/freedom-browser-integration/test/glue-smoke.cjs",
    "bundle:freedom": "node tools/bundle-for-freedom.mjs",
    "serve:vault-test": "python3 -m http.server 8765 --directory examples/freedom-browser-integration/test-page"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "qrcode-generator": "^1.4.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.9"
}
