{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "paths": {
      "@vault/protocol": ["../../packages/protocol/src/index.ts"],
      "@vault/crypto-core": ["../../packages/crypto-core/src/index.ts"],
      "@vault/vault-core": ["../../packages/vault-core/src/index.ts"],
      "@vault/sdk": ["../../packages/sdk/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "modules/**/*.ts"],
  "exclude": ["node_modules", "modules/**/ios/**", "modules/**/android/**"]
}
