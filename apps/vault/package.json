{
  "name": "@vault/app",
  "version": "0.3.1",
  "private": true,
  "description": "VAULT mobile app (Expo / React Native). Biometric-gated, on-device encrypted vault with the crypto-wallet-style permission protocol.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vault/crypto-core": "workspace:*",
    "@vault/protocol": "workspace:*",
    "@vault/sdk": "workspace:*",
    "@vault/vault-core": "workspace:*",
    "expo": "~52.0.0",
    "expo-camera": "~16.0.0",
    "expo-crypto": "~14.0.0",
    "expo-file-system": "~18.0.0",
    "expo-linking": "~7.0.0",
    "expo-local-authentication": "~15.0.0",
    "expo-notifications": "~0.29.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-get-random-values": "~1.11.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.7.3"
  },
  "expo": {
    "install": {
      "exclude": []
    }
  }
}
